{
  "expo": {
    "name": "Rider Accept",
    "slug": "rider-accept-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1319",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1319"
    },
    "android": {
      "package": "com.rider.acceptpro",
      "jsEngine": "hermes",
      "permissions": [
        "INTERNET",
        "SYSTEM_ALERT_WINDOW",
        "BIND_ACCESSIBILITY_SERVICE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "BIND_NOTIFICATION_LISTENER_SERVICE",
        "VIBRATE",
        "QUERY_ALL_PACKAGES"
      ]
    },
    "plugins": [
      "./withAndroidAutomator.js"
    ]
  }
}
